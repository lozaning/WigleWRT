#!/usr/bin/env python3
"""
WigleWRT BLE Monitor Service
Exposes scanner status via Bluetooth Low Energy GATT server
"""

import dbus
import dbus.exceptions
import dbus.mainloop.glib
import dbus.service
import json
import subprocess
import os
import sys
import signal
from gi.repository import GLib

# BLE Service UUIDs
WIGLEWRT_SERVICE_UUID = '12345678-1234-5678-1234-56789abcdef0'
STATUS_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef1'
GPS_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef2'
NETWORKS_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef3'
SESSION_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef4'
RADIOS_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef5'
ACTIVITY_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef6'

BLUEZ_SERVICE_NAME = 'org.bluez'
GATT_MANAGER_IFACE = 'org.bluez.GattManager1'
DBUS_OM_IFACE = 'org.freedesktop.DBus.ObjectManager'
DBUS_PROP_IFACE = 'org.freedesktop.DBus.Properties'
GATT_SERVICE_IFACE = 'org.bluez.GattService1'
GATT_CHRC_IFACE = 'org.bluez.GattCharacteristic1'
GATT_DESC_IFACE = 'org.bluez.GattDescriptor1'
LE_ADVERTISING_MANAGER_IFACE = 'org.bluez.LEAdvertisingManager1'
LE_ADVERTISEMENT_IFACE = 'org.bluez.LEAdvertisement1'

DATA_DIR = '/etc/wiglewrt'
NETWORKS_FILE = f'{DATA_DIR}/networks.tsv'
SESSIONS_DIR = f'{DATA_DIR}/sessions'
PID_FILE = '/var/run/wiglewrt.pid'

mainloop = None


def get_scanner_status():
    """Get current scanner status"""
    running = False
    current_session = ''
    session_start = ''
    session_new = 0

    # Check if running
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, 'r') as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            running = True
        except (ValueError, OSError):
            pass

    # Get current session
    if running and os.path.exists(SESSIONS_DIR):
        for meta in sorted(os.listdir(SESSIONS_DIR), reverse=True):
            if meta.endswith('.meta'):
                meta_path = os.path.join(SESSIONS_DIR, meta)
                try:
                    with open(meta_path, 'r') as f:
                        content = f.read()
                    if 'status=running' in content:
                        current_session = meta.replace('.meta', '')
                        for line in content.split('\n'):
                            if line.startswith('start_time='):
                                session_start = line.split('=', 1)[1]
                            elif line.startswith('new_networks='):
                                session_new = int(line.split('=', 1)[1])
                        break
                except:
                    pass

    # Count total networks
    total_networks = 0
    if os.path.exists(NETWORKS_FILE):
        try:
            with open(NETWORKS_FILE, 'r') as f:
                total_networks = sum(1 for _ in f) - 1  # Subtract header
        except:
            pass

    return {
        'running': running,
        'current_session': current_session,
        'total_networks': max(0, total_networks),
        'session_start': session_start,
        'session_new': session_new
    }


def get_gps_status():
    """Get GPS status via ubus call"""
    try:
        result = subprocess.run(
            ['ubus', 'call', 'wiglewrt', 'gps_status'],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0:
            return json.loads(result.stdout)
    except:
        pass

    return {
        'available': False,
        'fix': False,
        'sats': 0,
        'lat': '',
        'lon': ''
    }


def get_radio_config():
    """Get radio configuration"""
    radios = []
    try:
        # Read UCI config
        result = subprocess.run(['uci', 'show', 'wiglewrt'], capture_output=True, text=True)
        if result.returncode == 0:
            config = {}
            for line in result.stdout.strip().split('\n'):
                if '=' in line:
                    key, value = line.split('=', 1)
                    config[key] = value.strip("'")

            for i in range(3):
                radio_id = f'radio{i}'
                enabled = config.get(f'wiglewrt.{radio_id}.enabled', '0') == '1'
                channels = config.get(f'wiglewrt.{radio_id}.channels', '')
                band = config.get(f'wiglewrt.{radio_id}.band', '2g' if i != 1 else '5g')

                radios.append({
                    'id': radio_id,
                    'enabled': enabled,
                    'band': band,
                    'channels': channels
                })
    except:
        pass

    return {'radios': radios, 'hop_interval': '500'}


def get_session_activity(limit=10):
    """Get recent session activity"""
    entries = []
    current = get_scanner_status().get('current_session', '')

    if current and os.path.exists(SESSIONS_DIR):
        log_file = os.path.join(SESSIONS_DIR, f'{current}.log')
        if os.path.exists(log_file):
            try:
                with open(log_file, 'r') as f:
                    lines = f.readlines()
                # Skip header, get last N entries
                for line in lines[-limit-1:-1] if len(lines) > limit else lines[1:]:
                    parts = line.strip().split('\t')
                    if len(parts) >= 10:
                        entries.append({
                            'timestamp': parts[0],
                            'bssid': parts[1],
                            'ssid': parts[2] or '<hidden>',
                            'channel': parts[3],
                            'signal': parts[4],
                            'lat': parts[5],
                            'lon': parts[6],
                            'is_new': parts[9] == '1'
                        })
            except:
                pass

    return {'entries': list(reversed(entries))}


class InvalidArgsException(dbus.exceptions.DBusException):
    _dbus_error_name = 'org.freedesktop.DBus.Error.InvalidArgs'


class NotSupportedException(dbus.exceptions.DBusException):
    _dbus_error_name = 'org.bluez.Error.NotSupported'


class NotPermittedException(dbus.exceptions.DBusException):
    _dbus_error_name = 'org.bluez.Error.NotPermitted'


class Advertisement(dbus.service.Object):
    PATH_BASE = '/org/bluez/wiglewrt/advertisement'

    def __init__(self, bus, index):
        self.path = self.PATH_BASE + str(index)
        self.bus = bus
        self.ad_type = 'peripheral'
        self.service_uuids = [WIGLEWRT_SERVICE_UUID]
        self.local_name = 'WigleWRT'
        self.include_tx_power = True
        dbus.service.Object.__init__(self, bus, self.path)

    def get_properties(self):
        properties = dict()
        properties['Type'] = self.ad_type
        properties['ServiceUUIDs'] = dbus.Array(self.service_uuids, signature='s')
        properties['LocalName'] = dbus.String(self.local_name)
        properties['IncludeTxPower'] = dbus.Boolean(self.include_tx_power)
        return {LE_ADVERTISEMENT_IFACE: properties}

    def get_path(self):
        return dbus.ObjectPath(self.path)

    @dbus.service.method(DBUS_PROP_IFACE, in_signature='s', out_signature='a{sv}')
    def GetAll(self, interface):
        if interface != LE_ADVERTISEMENT_IFACE:
            raise InvalidArgsException()
        return self.get_properties()[LE_ADVERTISEMENT_IFACE]

    @dbus.service.method(LE_ADVERTISEMENT_IFACE, in_signature='', out_signature='')
    def Release(self):
        print(f'{self.path}: Released!')


class Application(dbus.service.Object):
    """GATT Application"""

    def __init__(self, bus):
        self.path = '/org/bluez/wiglewrt'
        self.services = []
        dbus.service.Object.__init__(self, bus, self.path)
        self.add_service(WiglewrtService(bus, 0))

    def get_path(self):
        return dbus.ObjectPath(self.path)

    def add_service(self, service):
        self.services.append(service)

    @dbus.service.method(DBUS_OM_IFACE, out_signature='a{oa{sa{sv}}}')
    def GetManagedObjects(self):
        response = {}
        for service in self.services:
            response[service.get_path()] = service.get_properties()
            chrcs = service.get_characteristics()
            for chrc in chrcs:
                response[chrc.get_path()] = chrc.get_properties()
                descs = chrc.get_descriptors()
                for desc in descs:
                    response[desc.get_path()] = desc.get_properties()
        return response


class Service(dbus.service.Object):
    """GATT Service"""
    PATH_BASE = '/org/bluez/wiglewrt/service'

    def __init__(self, bus, index, uuid, primary):
        self.path = self.PATH_BASE + str(index)
        self.bus = bus
        self.uuid = uuid
        self.primary = primary
        self.characteristics = []
        dbus.service.Object.__init__(self, bus, self.path)

    def get_properties(self):
        return {
            GATT_SERVICE_IFACE: {
                'UUID': self.uuid,
                'Primary': self.primary,
                'Characteristics': dbus.Array(
                    self.get_characteristic_paths(),
                    signature='o')
            }
        }

    def get_path(self):
        return dbus.ObjectPath(self.path)

    def add_characteristic(self, characteristic):
        self.characteristics.append(characteristic)

    def get_characteristic_paths(self):
        return [c.get_path() for c in self.characteristics]

    def get_characteristics(self):
        return self.characteristics

    @dbus.service.method(DBUS_PROP_IFACE, in_signature='s', out_signature='a{sv}')
    def GetAll(self, interface):
        if interface != GATT_SERVICE_IFACE:
            raise InvalidArgsException()
        return self.get_properties()[GATT_SERVICE_IFACE]


class Characteristic(dbus.service.Object):
    """GATT Characteristic"""

    def __init__(self, bus, index, uuid, flags, service):
        self.path = service.path + '/char' + str(index)
        self.bus = bus
        self.uuid = uuid
        self.service = service
        self.flags = flags
        self.descriptors = []
        dbus.service.Object.__init__(self, bus, self.path)

    def get_properties(self):
        return {
            GATT_CHRC_IFACE: {
                'Service': self.service.get_path(),
                'UUID': self.uuid,
                'Flags': self.flags,
                'Descriptors': dbus.Array(
                    self.get_descriptor_paths(),
                    signature='o')
            }
        }

    def get_path(self):
        return dbus.ObjectPath(self.path)

    def add_descriptor(self, descriptor):
        self.descriptors.append(descriptor)

    def get_descriptor_paths(self):
        return [d.get_path() for d in self.descriptors]

    def get_descriptors(self):
        return self.descriptors

    @dbus.service.method(DBUS_PROP_IFACE, in_signature='s', out_signature='a{sv}')
    def GetAll(self, interface):
        if interface != GATT_CHRC_IFACE:
            raise InvalidArgsException()
        return self.get_properties()[GATT_CHRC_IFACE]

    @dbus.service.method(GATT_CHRC_IFACE, in_signature='a{sv}', out_signature='ay')
    def ReadValue(self, options):
        raise NotSupportedException()

    @dbus.service.method(GATT_CHRC_IFACE, in_signature='aya{sv}')
    def WriteValue(self, value, options):
        raise NotSupportedException()

    @dbus.service.method(GATT_CHRC_IFACE)
    def StartNotify(self):
        pass

    @dbus.service.method(GATT_CHRC_IFACE)
    def StopNotify(self):
        pass


class WiglewrtService(Service):
    """WigleWRT GATT Service"""

    def __init__(self, bus, index):
        Service.__init__(self, bus, index, WIGLEWRT_SERVICE_UUID, True)
        self.add_characteristic(StatusCharacteristic(bus, 0, self))
        self.add_characteristic(GpsCharacteristic(bus, 1, self))
        self.add_characteristic(NetworksCharacteristic(bus, 2, self))
        self.add_characteristic(SessionCharacteristic(bus, 3, self))
        self.add_characteristic(RadiosCharacteristic(bus, 4, self))
        self.add_characteristic(ActivityCharacteristic(bus, 5, self))


class StatusCharacteristic(Characteristic):
    """Scanner status characteristic"""

    def __init__(self, bus, index, service):
        Characteristic.__init__(self, bus, index, STATUS_CHAR_UUID, ['read', 'notify'], service)
        self.notifying = False

    def ReadValue(self, options):
        status = get_scanner_status()
        data = json.dumps(status)
        return [dbus.Byte(b) for b in data.encode('utf-8')]


class GpsCharacteristic(Characteristic):
    """GPS status characteristic"""

    def __init__(self, bus, index, service):
        Characteristic.__init__(self, bus, index, GPS_CHAR_UUID, ['read', 'notify'], service)

    def ReadValue(self, options):
        gps = get_gps_status()
        data = json.dumps(gps)
        return [dbus.Byte(b) for b in data.encode('utf-8')]


class NetworksCharacteristic(Characteristic):
    """Total networks count characteristic"""

    def __init__(self, bus, index, service):
        Characteristic.__init__(self, bus, index, NETWORKS_CHAR_UUID, ['read'], service)

    def ReadValue(self, options):
        status = get_scanner_status()
        data = json.dumps({'total': status['total_networks']})
        return [dbus.Byte(b) for b in data.encode('utf-8')]


class SessionCharacteristic(Characteristic):
    """Current session info characteristic"""

    def __init__(self, bus, index, service):
        Characteristic.__init__(self, bus, index, SESSION_CHAR_UUID, ['read'], service)

    def ReadValue(self, options):
        status = get_scanner_status()
        data = json.dumps({
            'session_id': status['current_session'],
            'start_time': status['session_start'],
            'new_networks': status['session_new']
        })
        return [dbus.Byte(b) for b in data.encode('utf-8')]


class RadiosCharacteristic(Characteristic):
    """Radio configuration characteristic"""

    def __init__(self, bus, index, service):
        Characteristic.__init__(self, bus, index, RADIOS_CHAR_UUID, ['read'], service)

    def ReadValue(self, options):
        radios = get_radio_config()
        data = json.dumps(radios)
        return [dbus.Byte(b) for b in data.encode('utf-8')]


class ActivityCharacteristic(Characteristic):
    """Recent session activity characteristic"""

    def __init__(self, bus, index, service):
        Characteristic.__init__(self, bus, index, ACTIVITY_CHAR_UUID, ['read'], service)

    def ReadValue(self, options):
        activity = get_session_activity(10)
        data = json.dumps(activity)
        return [dbus.Byte(b) for b in data.encode('utf-8')]


def find_adapter(bus):
    """Find the Bluetooth adapter"""
    remote_om = dbus.Interface(bus.get_object(BLUEZ_SERVICE_NAME, '/'),
                               DBUS_OM_IFACE)
    objects = remote_om.GetManagedObjects()

    for o, props in objects.items():
        if GATT_MANAGER_IFACE in props.keys():
            return o
    return None


def register_ad_cb():
    print('Advertisement registered')


def register_ad_error_cb(error):
    print(f'Failed to register advertisement: {error}')
    mainloop.quit()


def register_app_cb():
    print('GATT application registered')


def register_app_error_cb(error):
    print(f'Failed to register application: {error}')
    mainloop.quit()


def shutdown(signum, frame):
    print('Shutting down...')
    mainloop.quit()


def main():
    global mainloop

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

    bus = dbus.SystemBus()

    adapter = find_adapter(bus)
    if not adapter:
        print('BLE adapter not found')
        sys.exit(1)

    # Power on adapter
    adapter_props = dbus.Interface(bus.get_object(BLUEZ_SERVICE_NAME, adapter),
                                   DBUS_PROP_IFACE)
    adapter_props.Set('org.bluez.Adapter1', 'Powered', dbus.Boolean(1))

    service_manager = dbus.Interface(
        bus.get_object(BLUEZ_SERVICE_NAME, adapter),
        GATT_MANAGER_IFACE)

    ad_manager = dbus.Interface(
        bus.get_object(BLUEZ_SERVICE_NAME, adapter),
        LE_ADVERTISING_MANAGER_IFACE)

    advertisement = Advertisement(bus, 0)
    app = Application(bus)

    mainloop = GLib.MainLoop()

    # Register signal handlers
    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    ad_manager.RegisterAdvertisement(
        advertisement.get_path(), {},
        reply_handler=register_ad_cb,
        error_handler=register_ad_error_cb)

    service_manager.RegisterApplication(
        app.get_path(), {},
        reply_handler=register_app_cb,
        error_handler=register_app_error_cb)

    print('WigleWRT BLE service started')
    print(f'Service UUID: {WIGLEWRT_SERVICE_UUID}')
    print('Waiting for connections...')

    mainloop.run()

    ad_manager.UnregisterAdvertisement(advertisement.get_path())
    print('Advertisement unregistered')


if __name__ == '__main__':
    main()
