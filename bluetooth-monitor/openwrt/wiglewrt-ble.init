#!/bin/sh /etc/rc.common
# WigleWRT BLE Monitor Service Init Script

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/wiglewrt-ble
PIDFILE=/var/run/wiglewrt-ble.pid

start_service() {
    logger -t wiglewrt-ble "Starting WigleWRT BLE service"

    # Check if Bluetooth is available
    if ! hciconfig hci0 up 2>/dev/null; then
        logger -t wiglewrt-ble "Error: Bluetooth adapter not found"
        return 1
    fi

    procd_open_instance
    procd_set_param command $PROG
    procd_set_param respawn
    procd_set_param pidfile $PIDFILE
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    logger -t wiglewrt-ble "Stopping WigleWRT BLE service"
}

service_triggers() {
    procd_add_reload_trigger "wiglewrt"
}
