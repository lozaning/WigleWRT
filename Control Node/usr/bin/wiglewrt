#!/bin/sh
# wiglewrt - Main controller for WigleWRT v2
# Manages GPS, scanner, and session processes

# Use absolute path for device deployment
. /usr/share/wiglewrt/lib/common.sh

VERSION="2.5.0"

# Default configuration - fixed_500 is the best performing strategy
STRATEGY="${STRATEGY:-fixed}"
DWELL_MS="${DWELL_MS:-500}"

usage() {
    cat << EOF
WigleWRT v$VERSION - WiFi Scanner

Usage: $0 <command> [options]

Commands:
    start [dwell_ms]     Start scanning (default: 500ms dwell)
    stop                 Stop scanning
    status               Show status
    restart [dwell_ms]   Restart scanning

Dwell times (tested performance):
    500     Best balance - 82 networks/8min (default)
    1000    Slower scan - 66 networks/8min
    100     Faster scan - 64 networks/8min

Examples:
    $0 start                     # Start with default (500ms dwell)
    $0 start 100                 # Start with 100ms dwell
    $0 start 1000                # Start with 1000ms dwell
    $0 status                    # Show current status
EOF
}

# Find wireless interfaces
find_interfaces() {
    for phy in $(get_phys); do
        iface=$(get_interface "$phy")
        [ -n "$iface" ] && echo "$iface"
    done
}

# Start a new session
start_session() {
    local session_id=$(date +%Y%m%d_%H%M%S)

    mkdir -p "$SESSION_DIR"

    # Archive any existing current.csv from prior session (e.g., power loss)
    if [ -f "$CURRENT_SESSION" ]; then
        local archive_id=$(date +%Y%m%d_%H%M%S)
        mv "$CURRENT_SESSION" "$SESSION_DIR/${archive_id}.csv"
        log info "Archived previous session: ${archive_id}.csv"
    fi

    # Clear seen BSSIDs file
    rm -f "$WIGLEWRT_TMP/seen_bssids.txt"

    # Always start fresh session with WiGLE header
    cat > "$CURRENT_SESSION" << 'EOF'
WigleWifi-1.4,appRelease=WigleWRT,model=OpenWRT,release=v2.5.0,device=router,display=none,board=mediatek,brand=unknown
MAC,SSID,AuthMode,FirstSeen,Channel,RSSI,CurrentLatitude,CurrentLongitude,AltitudeMeters,AccuracyMeters,Type
EOF

    # Initialize session state
    echo "{\"unique_networks\":0,\"total_sightings\":0}" > "$SESSION_STATE"

    log info "Started new session: $session_id"
}

# Start all services
start_scanning() {
    local dwell="${1:-$DWELL_MS}"

    # Global lock to prevent concurrent starts
    GLOBAL_LOCK="$WIGLEWRT_TMP/start.lock"
    mkdir -p "$WIGLEWRT_TMP"
    if ! acquire_lock "$GLOBAL_LOCK"; then
        log error "Another start operation in progress"
        exit 1
    fi
    # Ensure lock is released on exit
    trap "release_lock '$GLOBAL_LOCK' 2>/dev/null" EXIT

    # Check if already running
    if is_running "$WIGLEWRT_TMP/wiglewrt.pid"; then
        log error "WigleWRT already running"
        release_lock "$GLOBAL_LOCK"
        exit 1
    fi

    # Clean up stale PID files before starting
    cleanup_stale_pids "$WIGLEWRT_TMP"

    log info "Starting WigleWRT with ${dwell}ms dwell time"

    # Initialize runtime
    init_runtime

    # Save dwell time for status display
    echo "fixed_${dwell}" > /tmp/wiglewrt_strategy

    # Start GPS daemon
    log info "Starting GPS daemon..."
    /usr/bin/wiglewrt-gps start </dev/null >/dev/null 2>&1 &

    # Wait for GPS daemon to actually start (max 5 seconds)
    for i in 1 2 3 4 5; do
        if is_running "$WIGLEWRT_TMP/gps.pid"; then
            log info "GPS daemon started"
            break
        fi
        sleep 1
    done

    if ! is_running "$WIGLEWRT_TMP/gps.pid"; then
        log warn "GPS daemon may not have started properly"
    fi

    # Start a new session (archives any prior session)
    start_session

    # Find and start scanners for each interface
    local ifaces=$(find_interfaces)
    local scanner_pids=""

    for iface in $ifaces; do
        log info "Starting scanner on $iface..."
        /usr/bin/wiglewrt-scan "$iface" "fixed" "$dwell" run </dev/null >/dev/null 2>&1 &
        local pid=$!
        echo "$pid" > "/tmp/wiglewrt/scan_${iface}.pid"
        scanner_pids="$scanner_pids $pid"
    done

    # Save PIDs
    echo "$GPS_PID $scanner_pids" > "$WIGLEWRT_TMP/pids"
    write_pid "$WIGLEWRT_TMP/wiglewrt.pid"

    # Start LED daemon
    /usr/bin/wiglewrt-leds start </dev/null >/dev/null 2>&1 &

    log info "WigleWRT started"

    # Write initial status
    write_status "true" "0" "0/s" "fixed_${dwell}"

    # Wait for child processes - keeps main script alive for procd
    # This prevents procd from restarting and creating duplicate children
    wait
}

# Archive current session to timestamped file
archive_session() {
    if [ -f "$CURRENT_SESSION" ]; then
        # Check if session has any data (more than 2 lines = header + data)
        local line_count=$(wc -l < "$CURRENT_SESSION" | tr -d ' ')
        if [ "$line_count" -gt 2 ]; then
            local session_id=$(date +%Y%m%d_%H%M%S)
            mv "$CURRENT_SESSION" "$SESSION_DIR/${session_id}.csv"
            log info "Archived session: ${session_id}.csv"
            sync
        else
            # Empty session, just remove it
            rm -f "$CURRENT_SESSION"
            log info "Removed empty session"
        fi
    fi

    # Clear session state
    rm -f "$SESSION_STATE" "$WIGLEWRT_TMP/seen_bssids.txt"
}

# Stop all services
stop_scanning() {
    if [ ! -f "$WIGLEWRT_TMP/pids" ]; then
        log warn "WigleWRT not running"
        return
    fi

    log info "Stopping WigleWRT..."

    # Archive the current session before stopping
    archive_session

    # Kill all child processes by PID file
    for pid in $(cat "$WIGLEWRT_TMP/pids" 2>/dev/null); do
        kill "$pid" 2>/dev/null
    done

    # Kill scanner processes by pid files
    for pidfile in /tmp/wiglewrt/scan_*.pid; do
        if [ -f "$pidfile" ]; then
            local pid=$(cat "$pidfile" 2>/dev/null)
            [ -n "$pid" ] && kill "$pid" 2>/dev/null
            rm -f "$pidfile"
        fi
    done

    # Stop GPS daemon
    /usr/bin/wiglewrt-gps stop 2>/dev/null

    # Stop LED daemon
    /usr/bin/wiglewrt-leds stop 2>/dev/null

    # Kill any remaining scan processes
    killall wiglewrt-scan 2>/dev/null
    killall -9 iw 2>/dev/null

    # Cleanup PID files and locks
    rm -f "$WIGLEWRT_TMP/pids" "$WIGLEWRT_TMP/wiglewrt.pid"
    rm -rf "$WIGLEWRT_TMP/start.lock" "$WIGLEWRT_TMP/gps.lock"

    write_status "false" "0" "0/s" ""

    log info "WigleWRT stopped"
}

# Show status
show_status() {
    if is_running "$WIGLEWRT_TMP/wiglewrt.pid"; then
        echo "WigleWRT: RUNNING"
        echo "Strategy: $(cat /tmp/wiglewrt_strategy 2>/dev/null || echo unknown)"

        # Read session state for counts
        if [ -f "$SESSION_STATE" ]; then
            local unique=$(grep -o '"unique_networks":[0-9]*' "$SESSION_STATE" 2>/dev/null | cut -d: -f2)
            local sightings=$(grep -o '"total_sightings":[0-9]*' "$SESSION_STATE" 2>/dev/null | cut -d: -f2)
            echo "Unique Networks: ${unique:-0}"
            echo "Total Sightings: ${sightings:-0}"
        fi

        # GPS status
        local gps=$(cat "$GPS_FILE" 2>/dev/null)
        if [ -n "$gps" ]; then
            echo "GPS: $(echo "$gps" | cut -f1),$(echo "$gps" | cut -f2)"
        else
            echo "GPS: No fix"
        fi

        # Show running processes
        echo "Processes:"
        for pid in $(cat "$WIGLEWRT_TMP/pids" 2>/dev/null); do
            if kill -0 "$pid" 2>/dev/null; then
                echo "  $pid: running"
            else
                echo "  $pid: stopped"
            fi
        done
    else
        echo "WigleWRT: STOPPED"

        # Show archived sessions count
        local session_count=$(ls -1 "$SESSION_DIR"/*.csv 2>/dev/null | wc -l)
        echo "Archived sessions: ${session_count:-0}"
    fi
}

# Main
case "$1" in
    start)
        start_scanning "$2"
        ;;
    stop)
        stop_scanning
        ;;
    restart)
        stop_scanning
        sleep 2
        start_scanning "$2"
        ;;
    status)
        show_status
        ;;
    --version|-v)
        echo "WigleWRT v$VERSION"
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
