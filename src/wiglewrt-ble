#!/usr/bin/env python3
"""
WigleWRT BLE Monitor Service
Exposes scanner status via Bluetooth Low Energy GATT server
Uses dbus-fast (async) for OpenWRT compatibility
"""

import asyncio
import json
import os
import signal
import subprocess
import sys

from dbus_fast import BusType, Variant
from dbus_fast.aio import MessageBus
from dbus_fast.service import ServiceInterface, method, dbus_property
from dbus_fast.constants import PropertyAccess

DEBUG = True

def debug(msg):
    if DEBUG:
        print(f'[DEBUG] {msg}', flush=True)

# BLE Service UUIDs
WIGLEWRT_SERVICE_UUID = '12345678-1234-5678-1234-56789abcdef0'
STATUS_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef1'
GPS_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef2'
NETWORKS_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef3'
SESSION_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef4'
RADIOS_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef5'
ACTIVITY_CHAR_UUID = '12345678-1234-5678-1234-56789abcdef6'

# BlueZ D-Bus constants
BLUEZ_SERVICE = 'org.bluez'
ADAPTER_IFACE = 'org.bluez.Adapter1'
GATT_MANAGER_IFACE = 'org.bluez.GattManager1'
LE_ADVERTISING_MANAGER_IFACE = 'org.bluez.LEAdvertisingManager1'
GATT_SERVICE_IFACE = 'org.bluez.GattService1'
GATT_CHRC_IFACE = 'org.bluez.GattCharacteristic1'
LE_ADVERTISEMENT_IFACE = 'org.bluez.LEAdvertisement1'
DBUS_OM_IFACE = 'org.freedesktop.DBus.ObjectManager'
DBUS_PROP_IFACE = 'org.freedesktop.DBus.Properties'

DATA_DIR = '/etc/wiglewrt'
NETWORKS_FILE = f'{DATA_DIR}/networks.tsv'
SESSIONS_DIR = f'{DATA_DIR}/sessions'
PID_FILE = '/var/run/wiglewrt.pid'

APP_PATH = '/org/bluez/wiglewrt'
SERVICE_PATH = f'{APP_PATH}/service0'
AD_PATH = f'{APP_PATH}/advertisement0'


def get_scanner_status():
    """Get current scanner status"""
    running = False
    current_session = ''
    session_start = ''
    session_new = 0

    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, 'r') as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            running = True
        except (ValueError, OSError):
            pass

    if running and os.path.exists(SESSIONS_DIR):
        for meta in sorted(os.listdir(SESSIONS_DIR), reverse=True):
            if meta.endswith('.meta'):
                meta_path = os.path.join(SESSIONS_DIR, meta)
                try:
                    with open(meta_path, 'r') as f:
                        content = f.read()
                    if 'status=running' in content:
                        current_session = meta.replace('.meta', '')
                        for line in content.split('\n'):
                            if line.startswith('start_time='):
                                session_start = line.split('=', 1)[1]
                            elif line.startswith('new_networks='):
                                try:
                                    session_new = int(line.split('=', 1)[1])
                                except:
                                    pass
                        break
                except:
                    pass

    total_networks = 0
    if os.path.exists(NETWORKS_FILE):
        try:
            with open(NETWORKS_FILE, 'r') as f:
                total_networks = sum(1 for _ in f) - 1
        except:
            pass

    return {
        'running': running,
        'current_session': current_session,
        'total_networks': max(0, total_networks),
        'session_start': session_start,
        'session_new': session_new
    }


def get_gps_status():
    """Get GPS status via ubus call"""
    try:
        result = subprocess.run(
            ['ubus', 'call', 'wiglewrt', 'gps_status'],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0:
            return json.loads(result.stdout)
    except:
        pass

    return {
        'available': False,
        'fix': False,
        'sats': 0,
        'lat': '',
        'lon': ''
    }


def get_radio_config():
    """Get radio configuration"""
    radios = []
    try:
        result = subprocess.run(['uci', 'show', 'wiglewrt'], capture_output=True, text=True)
        if result.returncode == 0:
            config = {}
            for line in result.stdout.strip().split('\n'):
                if '=' in line:
                    key, value = line.split('=', 1)
                    config[key] = value.strip("'")

            for i in range(3):
                radio_id = f'radio{i}'
                enabled = config.get(f'wiglewrt.{radio_id}.enabled', '0') == '1'
                channels = config.get(f'wiglewrt.{radio_id}.channels', '')
                band = config.get(f'wiglewrt.{radio_id}.band', '2g' if i != 1 else '5g')

                radios.append({
                    'id': radio_id,
                    'enabled': enabled,
                    'band': band,
                    'channels': channels
                })
    except:
        pass

    return {'radios': radios, 'hop_interval': '500'}


def get_session_activity(limit=10):
    """Get recent session activity"""
    entries = []
    current = get_scanner_status().get('current_session', '')

    if current and os.path.exists(SESSIONS_DIR):
        log_file = os.path.join(SESSIONS_DIR, f'{current}.log')
        if os.path.exists(log_file):
            try:
                with open(log_file, 'r') as f:
                    lines = f.readlines()
                for line in lines[-limit-1:-1] if len(lines) > limit else lines[1:]:
                    parts = line.strip().split('\t')
                    if len(parts) >= 10:
                        entries.append({
                            'timestamp': parts[0],
                            'bssid': parts[1],
                            'ssid': parts[2] or '<hidden>',
                            'channel': parts[3],
                            'signal': parts[4],
                            'lat': parts[5],
                            'lon': parts[6],
                            'is_new': parts[9] == '1'
                        })
            except:
                pass

    return {'entries': list(reversed(entries))}


class Advertisement(ServiceInterface):
    """BLE Advertisement"""

    def __init__(self):
        super().__init__(LE_ADVERTISEMENT_IFACE)
        self._type = 'peripheral'
        self._service_uuids = [WIGLEWRT_SERVICE_UUID]
        self._local_name = 'WigleWRT'
        self._include_tx_power = True

    @dbus_property(access=PropertyAccess.READ)
    def Type(self) -> 's':
        return self._type

    @dbus_property(access=PropertyAccess.READ)
    def ServiceUUIDs(self) -> 'as':
        return self._service_uuids

    @dbus_property(access=PropertyAccess.READ)
    def LocalName(self) -> 's':
        return self._local_name

    @dbus_property(access=PropertyAccess.READ)
    def IncludeTxPower(self) -> 'b':
        return self._include_tx_power

    @method()
    def Release(self):
        print('Advertisement released')


class GattService(ServiceInterface):
    """GATT Service"""

    def __init__(self):
        super().__init__(GATT_SERVICE_IFACE)
        self._uuid = WIGLEWRT_SERVICE_UUID
        self._primary = True

    @dbus_property(access=PropertyAccess.READ)
    def UUID(self) -> 's':
        return self._uuid

    @dbus_property(access=PropertyAccess.READ)
    def Primary(self) -> 'b':
        return self._primary


class GattCharacteristic(ServiceInterface):
    """Base GATT Characteristic"""

    def __init__(self, uuid, flags):
        super().__init__(GATT_CHRC_IFACE)
        self._uuid = uuid
        self._flags = flags
        self._service_path = SERVICE_PATH

    @dbus_property(access=PropertyAccess.READ)
    def UUID(self) -> 's':
        return self._uuid

    @dbus_property(access=PropertyAccess.READ)
    def Service(self) -> 'o':
        return self._service_path

    @dbus_property(access=PropertyAccess.READ)
    def Flags(self) -> 'as':
        return self._flags

    @method()
    def ReadValue(self, options: 'a{sv}') -> 'ay':
        return []

    @method()
    def WriteValue(self, value: 'ay', options: 'a{sv}'):
        pass

    @method()
    def StartNotify(self):
        pass

    @method()
    def StopNotify(self):
        pass


class StatusCharacteristic(GattCharacteristic):
    """Scanner status characteristic"""

    def __init__(self):
        super().__init__(STATUS_CHAR_UUID, ['read'])

    @method()
    def ReadValue(self, options: 'a{sv}') -> 'ay':
        debug('StatusCharacteristic.ReadValue called')
        status = get_scanner_status()
        data = json.dumps(status).encode('utf-8')
        debug(f'Returning status: {data}')
        return bytes(data)


class GpsCharacteristic(GattCharacteristic):
    """GPS status characteristic"""

    def __init__(self):
        super().__init__(GPS_CHAR_UUID, ['read'])

    @method()
    def ReadValue(self, options: 'a{sv}') -> 'ay':
        debug('GpsCharacteristic.ReadValue called')
        gps = get_gps_status()
        data = json.dumps(gps).encode('utf-8')
        debug(f'Returning GPS: {data}')
        return bytes(data)


class NetworksCharacteristic(GattCharacteristic):
    """Total networks count characteristic"""

    def __init__(self):
        super().__init__(NETWORKS_CHAR_UUID, ['read'])

    @method()
    def ReadValue(self, options: 'a{sv}') -> 'ay':
        debug('NetworksCharacteristic.ReadValue called')
        status = get_scanner_status()
        data = json.dumps({'total': status['total_networks']}).encode('utf-8')
        return bytes(data)


class SessionCharacteristic(GattCharacteristic):
    """Current session info characteristic"""

    def __init__(self):
        super().__init__(SESSION_CHAR_UUID, ['read'])

    @method()
    def ReadValue(self, options: 'a{sv}') -> 'ay':
        debug('SessionCharacteristic.ReadValue called')
        status = get_scanner_status()
        data = json.dumps({
            'session_id': status['current_session'],
            'start_time': status['session_start'],
            'new_networks': status['session_new']
        }).encode('utf-8')
        return bytes(data)


class RadiosCharacteristic(GattCharacteristic):
    """Radio configuration characteristic"""

    def __init__(self):
        super().__init__(RADIOS_CHAR_UUID, ['read'])

    @method()
    def ReadValue(self, options: 'a{sv}') -> 'ay':
        debug('RadiosCharacteristic.ReadValue called')
        radios = get_radio_config()
        data = json.dumps(radios).encode('utf-8')
        return bytes(data)


class ActivityCharacteristic(GattCharacteristic):
    """Recent session activity characteristic"""

    def __init__(self):
        super().__init__(ACTIVITY_CHAR_UUID, ['read'])

    @method()
    def ReadValue(self, options: 'a{sv}') -> 'ay':
        debug('ActivityCharacteristic.ReadValue called')
        activity = get_session_activity(10)
        data = json.dumps(activity).encode('utf-8')
        return bytes(data)


class ApplicationManager(ServiceInterface):
    """D-Bus ObjectManager for GATT Application"""

    def __init__(self, objects):
        super().__init__(DBUS_OM_IFACE)
        self._objects = objects

    @method()
    def GetManagedObjects(self) -> 'a{oa{sa{sv}}}':
        return self._objects


async def find_adapter(bus):
    """Find the Bluetooth adapter path"""
    introspection = await bus.introspect(BLUEZ_SERVICE, '/')
    proxy = bus.get_proxy_object(BLUEZ_SERVICE, '/', introspection)
    om = proxy.get_interface(DBUS_OM_IFACE)
    objects = await om.call_get_managed_objects()

    for path, interfaces in objects.items():
        if GATT_MANAGER_IFACE in interfaces:
            return path
    return None


async def power_on_adapter(bus, adapter_path):
    """Power on the Bluetooth adapter"""
    introspection = await bus.introspect(BLUEZ_SERVICE, adapter_path)
    proxy = bus.get_proxy_object(BLUEZ_SERVICE, adapter_path, introspection)
    props = proxy.get_interface(DBUS_PROP_IFACE)
    await props.call_set(ADAPTER_IFACE, 'Powered', Variant('b', True))
    print(f'Adapter {adapter_path} powered on')


async def register_application(bus, adapter_path):
    """Register GATT application with BlueZ"""
    # Create service and characteristics
    service = GattService()
    chars = [
        ('char0', StatusCharacteristic()),
        ('char1', GpsCharacteristic()),
        ('char2', NetworksCharacteristic()),
        ('char3', SessionCharacteristic()),
        ('char4', RadiosCharacteristic()),
        ('char5', ActivityCharacteristic()),
    ]

    # Build managed objects dict
    managed_objects = {}

    # Add service
    service_props = {
        GATT_SERVICE_IFACE: {
            'UUID': Variant('s', WIGLEWRT_SERVICE_UUID),
            'Primary': Variant('b', True),
            'Characteristics': Variant('ao', [f'{SERVICE_PATH}/{name}' for name, _ in chars])
        }
    }
    managed_objects[SERVICE_PATH] = service_props

    # Add characteristics
    for name, char in chars:
        char_path = f'{SERVICE_PATH}/{name}'
        char_props = {
            GATT_CHRC_IFACE: {
                'UUID': Variant('s', char._uuid),
                'Service': Variant('o', SERVICE_PATH),
                'Flags': Variant('as', char._flags),
            }
        }
        managed_objects[char_path] = char_props

    # Export application object manager
    app_manager = ApplicationManager(managed_objects)
    bus.export(APP_PATH, app_manager)

    # Export service
    bus.export(SERVICE_PATH, service)

    # Export characteristics
    for name, char in chars:
        bus.export(f'{SERVICE_PATH}/{name}', char)

    # Register with BlueZ
    introspection = await bus.introspect(BLUEZ_SERVICE, adapter_path)
    proxy = bus.get_proxy_object(BLUEZ_SERVICE, adapter_path, introspection)
    gatt_manager = proxy.get_interface(GATT_MANAGER_IFACE)

    try:
        await gatt_manager.call_register_application(APP_PATH, {})
        print('GATT application registered')
        return True
    except Exception as e:
        print(f'Failed to register GATT application: {e}')
        return False


async def register_advertisement(bus, adapter_path):
    """Register BLE advertisement"""
    ad = Advertisement()
    bus.export(AD_PATH, ad)

    introspection = await bus.introspect(BLUEZ_SERVICE, adapter_path)
    proxy = bus.get_proxy_object(BLUEZ_SERVICE, adapter_path, introspection)
    ad_manager = proxy.get_interface(LE_ADVERTISING_MANAGER_IFACE)

    try:
        await ad_manager.call_register_advertisement(AD_PATH, {})
        print('Advertisement registered')
        return True
    except Exception as e:
        print(f'Failed to register advertisement: {e}')
        return False


async def main():
    print('WigleWRT BLE Service starting...', flush=True)
    print(f'Service UUID: {WIGLEWRT_SERVICE_UUID}', flush=True)

    # Connect to system bus and request a well-known name
    bus = await MessageBus(bus_type=BusType.SYSTEM).connect()
    await bus.request_name('org.wiglewrt.ble')
    print('Connected to D-Bus as org.wiglewrt.ble', flush=True)

    # Find adapter
    adapter_path = await find_adapter(bus)
    if not adapter_path:
        print('Error: No Bluetooth adapter found', flush=True)
        sys.exit(1)
    print(f'Found adapter: {adapter_path}', flush=True)

    # Power on adapter
    await power_on_adapter(bus, adapter_path)

    # Register GATT application
    if not await register_application(bus, adapter_path):
        sys.exit(1)

    # Register advertisement
    if not await register_advertisement(bus, adapter_path):
        sys.exit(1)

    print('WigleWRT BLE service started', flush=True)
    print('Waiting for connections...', flush=True)

    # Setup shutdown handler
    stop_event = asyncio.Event()

    def signal_handler():
        print('\nShutting down...')
        stop_event.set()

    loop = asyncio.get_event_loop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(sig, signal_handler)

    # Wait for shutdown signal
    await stop_event.wait()

    # Cleanup
    try:
        introspection = await bus.introspect(BLUEZ_SERVICE, adapter_path)
        proxy = bus.get_proxy_object(BLUEZ_SERVICE, adapter_path, introspection)

        ad_manager = proxy.get_interface(LE_ADVERTISING_MANAGER_IFACE)
        await ad_manager.call_unregister_advertisement(AD_PATH)
        print('Advertisement unregistered')

        gatt_manager = proxy.get_interface(GATT_MANAGER_IFACE)
        await gatt_manager.call_unregister_application(APP_PATH)
        print('GATT application unregistered')
    except:
        pass

    bus.disconnect()
    print('Disconnected from D-Bus')


if __name__ == '__main__':
    asyncio.run(main())
